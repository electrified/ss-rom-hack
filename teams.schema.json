{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensible Soccer canonical team data",
  "description": "Canonical team data format.",
  "type": "object",
  "required": [
    "national",
    "club",
    "custom"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "national": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "club": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "custom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team"
      }
    }
  },
  "$defs": {
    "team": {
      "type": "object",
      "required": [
        "team",
        "country",
        "coach",
        "formation",
        "skill",
        "flag",
        "kit",
        "players"
      ],
      "additionalProperties": false,
      "properties": {
        "team": {
          "type": "string",
          "pattern": "^[A-Z .'-]*$",
          "maxLength": 25
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z .'-]*$",
          "maxLength": 19
        },
        "coach": {
          "type": "string",
          "pattern": "^[A-Z .'-]*$",
          "maxLength": 25
        },
        "formation": {
          "type": "string",
          "enum": [
            "4-4-2",
            "5-4-1",
            "4-5-1",
            "5-3-2",
            "3-5-2",
            "4-3-3",
            "Attack",
            "Defend"
          ]
        },
        "skill": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "flag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "kit": {
          "type": "object",
          "required": [
            "first",
            "second"
          ],
          "additionalProperties": false,
          "properties": {
            "first": {
              "$ref": "#/$defs/kitSet"
            },
            "second": {
              "$ref": "#/$defs/kitSet"
            }
          }
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/player"
          },
          "minItems": 16,
          "maxItems": 16
        }
      }
    },
    "player": {
      "type": "object",
      "required": [
        "name",
        "number",
        "position",
        "role",
        "head"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z .'-]*$",
          "maxLength": 25
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "position": {
          "type": "string",
          "enum": [
            "goalkeeper",
            "right_back",
            "left_back",
            "centre_back",
            "defender",
            "right_midfielder",
            "centre_midfielder",
            "left_midfielder",
            "midfielder",
            "forward",
            "second_forward",
            "sub"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "goalkeeper",
            "defender",
            "midfielder",
            "forward"
          ]
        },
        "head": {
          "type": "string",
          "enum": [
            "white_dark",
            "white_blonde",
            "black_dark"
          ]
        },
        "star": {
          "type": "boolean"
        }
      }
    },
    "kitSet": {
      "type": "object",
      "required": [
        "style",
        "shirt1",
        "shirt2",
        "shorts",
        "socks"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": [
            "plain",
            "sleeves",
            "vertical",
            "horizontal"
          ]
        },
        "shirt1": {
          "type": "string",
          "enum": [
            "grey",
            "white",
            "black",
            "orange",
            "red",
            "blue",
            "dark_red",
            "light_blue",
            "green",
            "yellow"
          ]
        },
        "shirt2": {
          "type": "string",
          "enum": [
            "grey",
            "white",
            "black",
            "orange",
            "red",
            "blue",
            "dark_red",
            "light_blue",
            "green",
            "yellow"
          ]
        },
        "shorts": {
          "type": "string",
          "enum": [
            "grey",
            "white",
            "black",
            "orange",
            "red",
            "blue",
            "dark_red",
            "light_blue",
            "green",
            "yellow"
          ]
        },
        "socks": {
          "type": "string",
          "enum": [
            "grey",
            "white",
            "black",
            "orange",
            "red",
            "blue",
            "dark_red",
            "light_blue",
            "green",
            "yellow"
          ]
        }
      }
    }
  }
}
